# ── NEXUS-AI-CORE · Environment Variables ──────────────────────────────────
# Copy to .env and fill in all values before starting.

# === Shopify ===
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxx
SHOPIFY_WEBHOOK_SECRET=whsec_xxxx

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_ID_STARTER=price_xxxx
STRIPE_PRICE_ID_GROWTH=price_xxxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxxx

# === HubSpot ===
HUBSPOT_ACCESS_TOKEN=pat-xxxx
HUBSPOT_PORTAL_ID=12345678

# === Notion ===
NOTION_API_KEY=secret_xxxx
NOTION_AUDIT_DB_ID=xxxx
NOTION_MEMORY_DB_ID=xxxx
NOTION_DOCS_PAGE_ID=xxxx

# === Linear ===
LINEAR_API_KEY=lin_api_xxxx
LINEAR_TEAM_ID=xxxx
LINEAR_PROJECT_ID=xxxx
LINEAR_WEBHOOK_SECRET=xxxx

# === Supabase ===
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# === HuggingFace ===
HUGGINGFACE_API_TOKEN=hf_xxxx
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_SCORE_MODEL=Garrettc123/nexus-deal-scorer

# === DocuSign ===
DOCUSIGN_INTEGRATION_KEY=xxxx
DOCUSIGN_USER_ID=xxxx
DOCUSIGN_ACCOUNT_ID=xxxx
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_PRIVATE_KEY_PATH=./secrets/docusign_rsa.key

# === Internal ===
NEXUS_ENV=production
NEXUS_SECRET=change_me_32chars_minimum
LOG_LEVEL=INFO
